# Optional secure CV ingestion configuration.
TI_MAX_CV_SIZE_MB=10
TI_MAX_PDF_PAGES=50
TI_MAX_DOCX_UNCOMPRESSED_MB=50
TI_MAX_EXTRACTED_TEXT_CHARS=500000
TI_MALWARE_SCAN_ENABLED=true
TI_CLAMAV_HOST=clamav
TI_CLAMAV_PORT=3310
TI_ALLOW_UNSCANNED_UPLOADS_IN_DEVELOPMENT=false
TI_RAW_CV_RETENTION_DAYS=7
TI_DELETE_RAW_CV_AFTER_EXTRACTION=false
TI_TEMP_ARTIFACT_RETENTION_HOURS=24
TI_MASK_COMPANY_NAMES=false
TI_PII_REVIEW_THRESHOLD=0.70
TI_PII_ACTIVE_KEY_VERSION=v1
# JSON map of key version to base64-encoded 32-byte key. Never commit a real key.
TI_PII_ENCRYPTION_KEYS_JSON={}
